{% comment %}
  PlumeX — Home v3 — Étapes du rituel
{% endcomment %}
{% style %}
.plumex-home .ritual-head{text-align:center;max-width:560px;margin:0 auto 50px}
.plumex-home .ritual-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 8px}
.plumex-home .ritual-head p{color:var(--ink-soft)}
.plumex-home .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.plumex-home .step{background:var(--brand-soft);border:1px solid var(--line);border-radius:var(--r);padding:28px 22px}
.plumex-home .step .no{font-family:var(--mono);font-size:.85rem;color:var(--brand-accent);font-weight:700}
.plumex-home .step h3{font-size:1.22rem;margin:14px 0 7px}
.plumex-home .step p{font-size:.89rem;color:var(--ink-soft)}
.plumex-home .step .bar{height:3px;background:linear-gradient(90deg,var(--brand-accent-2),var(--brand-accent));border-radius:3px;margin-top:18px;width:32px}
@media(max-width:960px){ .plumex-home .steps{grid-template-columns:repeat(2,1fr)} }
@media(max-width:560px){ .plumex-home .steps{grid-template-columns:1fr} }
{% endstyle %}

<div class="plumex-home">
  <section class="section">
    <div class="wrap">
      <div class="ritual-head reveal">
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.lead }}</p>
      </div>
      <div class="steps">
        {% for block in section.blocks %}
          <div class="step reveal" {{ block.shopify_attributes }}>
            <div class="no">{{ block.settings.number | default: forloop.index }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <div class="bar"></div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PlumeX — Étapes du rituel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Votre rituel" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "En 4 gestes, matin ou soir." },
    { "type": "textarea", "id": "lead", "label": "Sous-titre", "default": "Aucun effort. Aucune difficulté. Juste 10 minutes pour vous." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "number", "label": "Numéro (laisser vide = auto)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Froid ou chaud" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Au frigo pour l'effet dégonflant, ou 45 s au micro-ondes pour la détente." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PlumeX — Étapes du rituel",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Froid ou chaud", "description": "Au frigo pour l'effet dégonflant, ou 45 s au micro-ondes pour la détente." } },
        { "type": "step", "settings": { "number": "02", "title": "Enfilez", "description": "Il épouse le visage, l'obscurité se fait, le confort enveloppe." } },
        { "type": "step", "settings": { "number": "03", "title": "Compression douce", "description": "Une pression légère sur les tempes relâche la tension." } },
        { "type": "step", "settings": { "number": "04", "title": "Le résultat", "description": "Visage dégonflé et teint réveillé le matin ; peau apaisée le soir." } }
      ]
    }
  ]
}
{% endschema %}
