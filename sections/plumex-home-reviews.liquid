{% comment %}
  PlumeX — Home v3 — Avis clients (avis réels, texte inchangé)
{% endcomment %}
{% style %}
.plumex-home .reviews{background:var(--brand-soft)}
.plumex-home .rev-head{text-align:center;margin-bottom:44px}
.plumex-home .rev-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 10px}
.plumex-home .rev-grid{columns:3;column-gap:18px}
.plumex-home .rev{background:var(--brand-bg);border:1px solid var(--line);border-radius:15px;padding:22px;margin-bottom:18px;break-inside:avoid}
.plumex-home .rev .stars{font-size:.95rem;margin-bottom:11px}
.plumex-home .rev h4{font-family:var(--display);font-size:1.14rem;margin-bottom:7px}
.plumex-home .rev p{font-size:.89rem;color:var(--ink-soft);margin-bottom:13px}
.plumex-home .rev .who{font-size:.82rem;font-weight:600}
.plumex-home .rev .who span{color:var(--brand-accent);font-weight:500}
@media(max-width:960px){ .plumex-home .rev-grid{columns:2} }
@media(max-width:560px){ .plumex-home .rev-grid{columns:1} }
{% endstyle %}

<div class="plumex-home">
  <section class="reviews section" id="avis">
    <div class="wrap">
      <div class="rev-head reveal">
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <div class="stars" style="font-size:1.15rem">★★★★★ &nbsp;<span style="font-family:var(--body);font-size:.9rem;color:var(--ink-soft)">{{ section.settings.rating_summary }}</span></div>
      </div>
      <div class="rev-grid">
        {% for block in section.blocks %}
          <div class="rev" {{ block.shopify_attributes }}>
            <div class="stars">
              {% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}
            </div>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.body }}</p>
            <div class="who">{{ block.settings.author }} <span>· vérifié</span></div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PlumeX — Avis clients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nos clients en parlent mieux que nous" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils ont testé. Ils ne s'en passent plus." },
    { "type": "text", "id": "rating_summary", "label": "Résumé de note", "default": "4,8/5 · 2 000+ avis" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "stars", "label": "Étoiles", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Titre", "default": "J'adore" },
        { "type": "textarea", "id": "body", "label": "Texte de l'avis" },
        { "type": "text", "id": "author", "label": "Auteur", "default": "Cliente" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PlumeX — Avis clients",
      "blocks": [
        { "type": "review", "settings": { "stars": 5, "title": "J'adore", "body": "Au top ! Je le porte chaque soir avant de dormir, ça fait un bien fou. En plus, je me réveille avec un visage moins gonflé.", "author": "Sophie A." } },
        { "type": "review", "settings": { "stars": 5, "title": "Ce masque est dingue !", "body": "Le pack duo est devenu notre rituel quotidien : je comprends enfin pourquoi la cryothérapie est autant appréciée, la sensation de fraîcheur est incroyable !", "author": "Sylvie C." } },
        { "type": "review", "settings": { "stars": 5, "title": "Incroyable", "body": "Je pensais qu'il serait trop serré, mais le maintien est juste parfait.", "author": "Marie L." } },
        { "type": "review", "settings": { "stars": 5, "title": "J'adore", "body": "Ce bonnet est vraiment top : il soulage les maux de tête, les migraines et aide à se détendre après une longue journée.", "author": "Valérie M." } },
        { "type": "review", "settings": { "stars": 5, "title": "Incroyable produit", "body": "Wow, je viens de le recevoir à l'instant, je suis agréablement surprise du fait qu'il soit frais, sans même l'avoir mis au frigo.", "author": "Laura L." } },
        { "type": "review", "settings": { "stars": 5, "title": "Magnifique", "body": "Dès les premiers signes d'une migraine ophtalmique, la fraîcheur me soulage immédiatement.", "author": "Sara E." } }
      ]
    }
  ]
}
{% endschema %}
