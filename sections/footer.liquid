<footer class="px-footer" role="contentinfo">
  <div class="px-footer-top">
    <div>
      {%- if settings.logo -%}
        <img class="px-footer-brand-logo" src="{{ settings.logo | image_url: height: 96 }}" alt="{{ shop.name }}" height="48" width="auto" loading="lazy">
      {%- else -%}
        <div style="font-family:'Anton',sans-serif;font-size:1.8rem;color:white;margin-bottom:1rem;opacity:0.9;">{{ shop.name }}</div>
      {%- endif -%}
      <p class="px-footer-brand-desc">{{ section.settings.description | default: 'Des produits naturels et premium pour votre quotidien. Qualité garantie, livraison rapide.' }}</p>
      <div class="px-footer-socials">
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" class="px-footer-social" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.facebook != blank -%}
          <a href="{{ section.settings.facebook }}" class="px-footer-social" aria-label="Facebook" rel="noopener noreferrer" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" class="px-footer-social" aria-label="TikTok" rel="noopener noreferrer" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.28 8.28 0 004.84 1.55V6.79a4.85 4.85 0 01-1.07-.1z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- for i in (1..3) -%}
      {%- assign title_key = 'col_' | append: i | append: '_title' -%}
      {%- assign links_key = 'col_' | append: i | append: '_links' -%}
      <div class="px-footer-col">
        <h4>{{ section.settings[title_key] }}</h4>
        <div class="px-footer-links">
          {%- assign menu = linklists[section.settings[links_key]] -%}
          {%- for link in menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="px-footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</span>
    <div class="px-payment-icons">
      <span class="px-payment-icon">VISA</span>
      <span class="px-payment-icon">MC</span>
      <span class="px-payment-icon">AMEX</span>
      <span class="px-payment-icon">PayPal</span>
      <span class="px-payment-icon">CB</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Description de la marque" },
    { "type": "url", "id": "instagram", "label": "URL Instagram" },
    { "type": "url", "id": "facebook", "label": "URL Facebook" },
    { "type": "url", "id": "tiktok", "label": "URL TikTok" },
    { "type": "text", "id": "col_1_title", "label": "Colonne 1 — Titre", "default": "Navigation" },
    { "type": "link_list", "id": "col_1_links", "label": "Colonne 1 — Menu", "default": "main-menu" },
    { "type": "text", "id": "col_2_title", "label": "Colonne 2 — Titre", "default": "Informations" },
    { "type": "link_list", "id": "col_2_links", "label": "Colonne 2 — Menu", "default": "footer" },
    { "type": "text", "id": "col_3_title", "label": "Colonne 3 — Titre", "default": "Service client" },
    { "type": "link_list", "id": "col_3_links", "label": "Colonne 3 — Menu", "default": "footer" }
  ],
  "presets": [{ "name": "Pied de page" }]
}
{% endschema %}
