{% comment %}
  PlumeX — Home v3 — Comparatif chiffré (500g vs 120g)
{% endcomment %}
{% style %}
.plumex-home .data{background:var(--brand-dark);color:#fff;text-align:center}
.plumex-home .data .eyebrow{color:color-mix(in srgb,var(--brand-accent) 70%,#fff)}
.plumex-home .data h2{font-size:clamp(1.7rem,3vw,2.3rem);color:#fff;max-width:22ch;margin:14px auto 46px}
.plumex-home .data-cols{display:grid;grid-template-columns:1fr auto 1fr;gap:28px;align-items:center;max-width:820px;margin:0 auto}
.plumex-home .data-num{font-family:var(--mono);font-weight:700;font-size:clamp(3rem,9vw,5.6rem);line-height:1}
.plumex-home .data-num small{font-size:1.4rem}
.plumex-home .data-plumex .data-num{color:color-mix(in srgb,var(--brand-accent) 70%,#fff)}
.plumex-home .data-other{opacity:.55}
.plumex-home .data-lab{font-weight:600;letter-spacing:.13em;text-transform:uppercase;font-size:.72rem;margin-top:10px}
.plumex-home .data-sub{font-size:.85rem;color:color-mix(in srgb,#fff 60%,transparent);margin-top:6px}
.plumex-home .data-vs{font-family:var(--display);font-style:italic;font-size:1.35rem;color:color-mix(in srgb,#fff 50%,transparent)}
.plumex-home .data-note{margin-top:40px;font-size:.94rem;color:color-mix(in srgb,#fff 72%,transparent);max-width:52ch;margin-inline:auto}
@media(max-width:560px){
  .plumex-home .data-cols{grid-template-columns:1fr}
  .plumex-home .data-vs{transform:rotate(90deg)}
}
{% endstyle %}

<div class="plumex-home">
  <section class="data section">
    <div class="wrap">
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="data-cols">
        {% for block in section.blocks %}
          {% if forloop.index == 2 %}
            <div class="data-vs">{{ section.settings.vs_label | default: 'vs' }}</div>
          {% endif %}
          <div class="data-{{ block.settings.style }}" {{ block.shopify_attributes }}>
            <div class="data-num">{{ block.settings.number }}<small>{{ block.settings.unit }}</small></div>
            <div class="data-lab">{{ block.settings.label }}</div>
            <div class="data-sub">{{ block.settings.sub_label }}</div>
          </div>
        {% endfor %}
      </div>
      <p class="data-note">{{ section.settings.note }}</p>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PlumeX — Chiffres clés",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ce n'est pas un détail technique" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "C'est toute la différence entre un gadget et un vrai soin cryo." },
    { "type": "text", "id": "vs_label", "label": "Séparateur", "default": "vs" },
    { "type": "textarea", "id": "note", "label": "Note en bas", "default": "4× plus de gel : un froid profond qui tient, et assez de poids pour que les muscles se relâchent vraiment. Un masque cryo qui ne pèse rien ne détend rien." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistique",
      "settings": [
        { "type": "text", "id": "number", "label": "Nombre", "default": "500" },
        { "type": "text", "id": "unit", "label": "Unité (petit texte)", "default": "g" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "PlumeX Cryo Pro" },
        { "type": "text", "id": "sub_label", "label": "Sous-texte", "default": "gel médical · froid qui dure toute la séance" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "plumex", "label": "Mis en avant (PlumeX)" },
            { "value": "other", "label": "Estompé (concurrent)" }
          ],
          "default": "plumex"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PlumeX — Chiffres clés",
      "blocks": [
        { "type": "stat", "settings": { "number": "500", "unit": "g", "label": "PlumeX Cryo Pro", "sub_label": "gel médical · froid qui dure toute la séance", "style": "plumex" } },
        { "type": "stat", "settings": { "number": "120", "unit": "g", "label": "Masques classiques", "sub_label": "tiédit en 3 minutes · aucune pression", "style": "other" } }
      ]
    }
  ]
}
{% endschema %}
