<div class="px-section">
  <div class="px-container-narrow">
    <h1 class="px-h2" style="margin-bottom:2rem;">Mon panier</h1>

    {%- if cart.item_count > 0 -%}
      <div style="display:grid;grid-template-columns:1fr 380px;gap:3rem;align-items:start;">

        <!-- Cart Items -->
        <div>
          {%- for item in cart.items -%}
            <div class="px-cart-item" style="border-bottom:1px solid var(--px-border);padding:1.5rem 0;">
              <a href="{{ item.url }}">
                <img class="px-cart-item-img" src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" loading="lazy" style="width:100px;height:100px;">
              </a>
              <div class="px-cart-item-info">
                <a href="{{ item.url }}" class="px-cart-item-title" style="font-size:1rem;">{{ item.product_title }}</a>
                {%- if item.variant_title != 'Default Title' -%}
                  <div class="px-cart-item-variant">{{ item.variant_title }}</div>
                {%- endif -%}
                {%- if item.selling_plan_allocation -%}
                  <div style="font-size:0.8rem;color:#4d6945;font-weight:600;">{{ item.selling_plan_allocation.selling_plan.name }}</div>
                {%- endif -%}
                <div class="px-cart-item-price-row" style="margin-top:0.75rem;">
                  <div class="px-cart-item-qty">
                    <button onclick="updateQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})">−</button>
                    <span>{{ item.quantity }}</span>
                    <button onclick="updateQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
                  </div>
                  <div>
                    <div class="px-cart-item-price">{{ item.line_price | money }}</div>
                    {%- if item.original_line_price != item.line_price -%}
                      <div style="font-size:0.8rem;color:#999;text-decoration:line-through;">{{ item.original_line_price | money }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Order Summary -->
        <div style="background:var(--px-sage);border-radius:var(--px-radius-lg);padding:2rem;position:sticky;top:90px;">
          <h2 style="font-size:1.1rem;font-weight:800;margin-bottom:1.5rem;color:#0e1320;">Récapitulatif</h2>

          <div style="display:flex;justify-content:space-between;margin-bottom:0.75rem;font-size:0.9rem;">
            <span style="color:#5a6272;">Sous-total</span>
            <span style="font-weight:700;">{{ cart.total_price | money }}</span>
          </div>
          {%- if cart.total_discounts > 0 -%}
            <div style="display:flex;justify-content:space-between;margin-bottom:0.75rem;font-size:0.9rem;color:#4d6945;font-weight:700;">
              <span>Économies</span>
              <span>-{{ cart.total_discounts | money }}</span>
            </div>
          {%- endif -%}
          <div style="display:flex;justify-content:space-between;margin-bottom:0.75rem;font-size:0.9rem;">
            <span style="color:#5a6272;">Livraison</span>
            <span style="font-weight:700;color:#4d6945;">
              {%- if cart.total_price >= 6000 -%}Gratuite{%- else -%}Calculée au checkout{%- endif -%}
            </span>
          </div>

          <div style="border-top:1px solid var(--px-sage-dark);padding-top:1rem;margin-top:1rem;display:flex;justify-content:space-between;align-items:baseline;margin-bottom:1.5rem;">
            <span style="font-weight:800;font-size:1rem;">Total</span>
            <span style="font-size:1.4rem;font-weight:800;color:#0e1320;">{{ cart.total_price | money }}</span>
          </div>

          <!-- Discount code -->
          <details style="margin-bottom:1.25rem;">
            <summary style="cursor:pointer;font-size:0.88rem;font-weight:600;color:#4d6945;">+ Code promo</summary>
            <div style="margin-top:0.75rem;display:flex;gap:0.5rem;">
              <input type="text" placeholder="Code promo" style="flex:1;padding:0.6rem 0.875rem;border:1.5px solid var(--px-border);border-radius:8px;font-size:0.88rem;background:white;">
              <button class="px-btn px-btn-outline" style="padding:0.6rem 1rem;font-size:0.85rem;">Appliquer</button>
            </div>
          </details>

          <a href="/checkout" class="px-cart-checkout-btn" style="display:flex;text-align:center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Passer commande
          </a>

          <div class="px-cart-trust" style="margin-top:1rem;">
            <div class="px-cart-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              Paiement sécurisé
            </div>
            <div class="px-cart-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Retours 30j
            </div>
          </div>
        </div>
      </div>
    {%- else -%}
      <div style="text-align:center;padding:6rem 1rem;">
        <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 1.5rem;display:block;color:#4d6945;opacity:0.5;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <h2 style="font-size:1.4rem;font-weight:800;margin-bottom:0.75rem;">Votre panier est vide</h2>
        <p style="color:#5a6272;margin-bottom:2rem;">Découvrez nos produits et commencez votre shopping !</p>
        <a href="/collections/all" class="px-btn px-btn-primary px-btn-lg">Voir les produits</a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  async function updateQuantity(key, qty) {
    if (qty < 0) return;
    await fetch('/cart/change.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({id: key, quantity: qty})
    });
    location.reload();
  }
</script>

{% schema %}
{
  "name": "Page panier",
  "settings": [],
  "presets": [{ "name": "Page panier" }]
}
{% endschema %}
