{% comment %}
  Home page PlumeX — design "cryothérapie beauté, matin & soir".
  Remplace toutes les sections de la page d'accueil (voir templates/index.json).
  Produit affiché : change le handle ci-dessous si le produit est renommé.
{% endcomment %}
{% assign featured_product = all_products['masque-cryo-plumex™-decongestionne-anti-migraine-copie'] %}
{% style %}
.plumex-home{
    --brand-bg:      #FAF8FC;   /* fond principal (blanc lilas)        */
    --brand-soft:    #F1ECF8;   /* fond des sections claires (lilas)   */
    --brand-ink:     #1F1B47;   /* couleur du texte (indigo profond)   */
    --brand-accent:  #7A33D4;   /* TA couleur d'accent (violet marque) */
    --brand-accent-2:#A98CE0;   /* violet clair / lavande              */
    --brand-dark:    #1B1840;   /* fond des bandeaux foncés (indigo)   */
  }
.plumex-home{
    --ink-soft:color-mix(in srgb,var(--brand-ink) 62%,#fff);
    --line:color-mix(in srgb,var(--brand-ink) 12%,transparent);
    --display:'Playfair Display',Georgia,serif;
    --body:'Instrument Sans',system-ui,sans-serif;
    --mono:'Space Mono',monospace;
    --container:1180px;--r:18px;--ease:cubic-bezier(.22,.61,.36,1);
  }
.plumex-home *{margin:0;padding:0;box-sizing:border-box}
.plumex-home{font-family:var(--body);color:var(--brand-ink);background:var(--brand-bg);line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.plumex-home h1,.plumex-home h2,.plumex-home h3{font-family:var(--display);font-weight:600;line-height:1.06;letter-spacing:-.01em}
.plumex-home a{color:inherit;text-decoration:none}
.plumex-home img{max-width:100%;display:block}
.plumex-home .wrap{max-width:var(--container);margin:0 auto;padding:0 26px}
.plumex-home .eyebrow{font-family:var(--body);font-weight:600;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--brand-accent)}
.plumex-home .section{padding:clamp(60px,8vw,120px) 0}
.plumex-home :focus-visible{outline:2.5px solid var(--brand-accent);outline-offset:3px;border-radius:6px}
.plumex-home .btn{display:inline-flex;align-items:center;gap:.55em;font-family:var(--body);font-weight:600;font-size:.97rem;padding:15px 30px;border-radius:100px;border:none;cursor:pointer;background:var(--brand-ink);color:#fff;transition:transform .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease);box-shadow:0 10px 28px -14px color-mix(in srgb,var(--brand-ink) 70%,transparent)}
.plumex-home .btn:hover{transform:translateY(-2px);background:var(--brand-accent);box-shadow:0 16px 36px -14px color-mix(in srgb,var(--brand-accent) 70%,transparent)}
.plumex-home .btn .arw{transition:transform .35s var(--ease)}
.plumex-home .btn:hover .arw{transform:translateX(5px)}
.plumex-home .btn-ghost{background:transparent;color:var(--brand-ink);border:1px solid var(--line);box-shadow:none}
.plumex-home .btn-ghost:hover{background:var(--brand-soft);color:var(--brand-ink);box-shadow:none;transform:translateY(-2px)}
.plumex-home .hero{position:relative;padding:clamp(46px,6vw,84px) 0 clamp(58px,7vw,104px);overflow:hidden;background:var(--brand-bg)}
.plumex-home .hero::before{content:"";position:absolute;inset:0;z-index:0;opacity:.5;background:radial-gradient(55% 55% at 84% 16%,color-mix(in srgb,var(--brand-accent-2) 34%,transparent),transparent 60%),radial-gradient(52% 58% at 10% 90%,color-mix(in srgb,var(--brand-accent) 30%,transparent),transparent 62%)}
.plumex-home .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr .95fr;gap:54px;align-items:center}
.plumex-home .hero h1{font-size:clamp(2.5rem,5.2vw,4.3rem);margin:20px 0 22px}
.plumex-home .hero h1 em{font-style:italic;color:var(--brand-accent)}
.plumex-home .hero .lead{font-size:1.12rem;max-width:34ch;color:var(--ink-soft);margin-bottom:32px}
.plumex-home .hero-actions{display:flex;gap:13px;flex-wrap:wrap;align-items:center}
.plumex-home .proof{display:flex;align-items:center;gap:11px;margin-top:28px;font-size:.9rem;color:var(--ink-soft)}
.plumex-home .stars{color:var(--brand-accent-2);letter-spacing:2px}
.plumex-home .proof b{color:var(--brand-ink)}
.plumex-home .hero-visual{position:relative;aspect-ratio:4/4.3;border-radius:var(--r)}
.plumex-home .gel-blob{position:absolute;inset:7% 5% 9% 7%;border-radius:46% 54% 58% 42%/48% 46% 54% 52%;background:linear-gradient(150deg,color-mix(in srgb,var(--brand-accent) 70%,#fff),var(--brand-accent) 65%,var(--brand-dark));opacity:.85;filter:blur(2px);animation:plumexHome_morph 15s ease-in-out infinite}
@keyframes plumexHome_morph{0%,100%{border-radius:46% 54% 58% 42%/48% 46% 54% 52%;transform:rotate(0)}50%{border-radius:56% 44% 42% 58%/54% 58% 42% 46%;transform:rotate(4deg)}}
.plumex-home .glass-card{position:absolute;inset:0;border-radius:var(--r);background:linear-gradient(160deg,color-mix(in srgb,#fff 55%,transparent),color-mix(in srgb,#fff 16%,transparent));backdrop-filter:blur(6px);border:1px solid color-mix(in srgb,#fff 60%,transparent);box-shadow:0 30px 66px -30px color-mix(in srgb,var(--brand-ink) 55%,transparent);display:grid;place-items:center;text-align:center;overflow:hidden}
.plumex-home .float-chip{position:absolute;left:-14px;bottom:26px;z-index:3;background:var(--brand-bg);border-radius:15px;padding:12px 16px;box-shadow:0 18px 38px -18px color-mix(in srgb,var(--brand-ink) 55%,transparent);display:flex;gap:11px;align-items:center;max-width:236px;border:1px solid var(--line)}
.plumex-home .float-chip .fx{width:34px;height:34px;border-radius:9px;background:linear-gradient(140deg,var(--brand-accent-2),var(--brand-accent));flex:none}
.plumex-home .float-chip small{font-size:.74rem;color:var(--ink-soft);line-height:1.35}
.plumex-home .float-chip b{color:var(--brand-ink)}
.plumex-home .sens-head{text-align:center;max-width:640px;margin:0 auto 50px}
.plumex-home .sens-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 10px}
.plumex-home .sens-head p{color:var(--ink-soft)}
.plumex-home .sens-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.plumex-home .sens{background:var(--brand-soft);border-radius:var(--r);padding:28px 24px;border:1px solid var(--line);transition:transform .4s var(--ease),box-shadow .4s var(--ease)}
.plumex-home .sens:hover{transform:translateY(-5px);box-shadow:0 24px 46px -28px color-mix(in srgb,var(--brand-ink) 45%,transparent)}
.plumex-home .sens .ic{font-size:1.55rem;margin-bottom:14px}
.plumex-home .sens h3{font-size:1.24rem;margin-bottom:7px}
.plumex-home .sens p{font-size:.9rem;color:var(--ink-soft)}
.plumex-home .duo{position:relative;color:#fff;transition:background .8s var(--ease)}
.plumex-home .duo[data-mode="matin"]{background:linear-gradient(120deg,color-mix(in srgb,var(--brand-accent-2) 88%,#fff),var(--brand-accent-2) 55%,color-mix(in srgb,var(--brand-accent-2) 40%,var(--brand-dark)))}
.plumex-home .duo[data-mode="soir"]{background:linear-gradient(120deg,color-mix(in srgb,var(--brand-accent) 70%,var(--brand-dark)),var(--brand-dark) 60%,#0C0A22)}
.plumex-home .duo .wrap{position:relative;z-index:2}
.plumex-home .duo-head{display:flex;justify-content:space-between;align-items:flex-end;gap:22px;flex-wrap:wrap;margin-bottom:40px}
.plumex-home .duo-head .eyebrow{color:color-mix(in srgb,#fff 74%,transparent)}
.plumex-home .duo-head h2{font-size:clamp(1.9rem,3.6vw,3rem);color:#fff;max-width:16ch}
.plumex-home .toggle{display:inline-flex;background:color-mix(in srgb,#fff 16%,transparent);border:1px solid color-mix(in srgb,#fff 30%,transparent);border-radius:100px;padding:5px;backdrop-filter:blur(6px)}
.plumex-home .toggle button{font-family:var(--body);font-weight:600;font-size:.94rem;color:#fff;background:transparent;border:none;padding:10px 24px;border-radius:100px;cursor:pointer;transition:.35s var(--ease);opacity:.8}
.plumex-home .toggle button.on{background:#fff;color:var(--brand-ink);opacity:1}
.plumex-home .duo-body{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;min-height:270px}
.plumex-home .duo-panel{display:none;animation:plumexHome_fade .55s var(--ease)}
.plumex-home .duo-panel.show{display:block}
@keyframes plumexHome_fade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.plumex-home .duo-panel .tag{font-family:var(--mono);font-size:.8rem;letter-spacing:.04em;color:color-mix(in srgb,#fff 82%,transparent);margin-bottom:14px}
.plumex-home .duo-panel h3{font-size:clamp(1.6rem,3vw,2.3rem);color:#fff;margin-bottom:14px}
.plumex-home .duo-panel p{color:color-mix(in srgb,#fff 88%,transparent);max-width:42ch;margin-bottom:20px}
.plumex-home .duo-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.plumex-home .duo-list li{display:flex;gap:11px;align-items:center;font-size:.97rem;color:color-mix(in srgb,#fff 92%,transparent)}
.plumex-home .duo-list li::before{content:"";width:7px;height:7px;border-radius:50%;background:#fff;flex:none}
.plumex-home .duo-visual{aspect-ratio:1/1;border-radius:var(--r);background:color-mix(in srgb,#fff 12%,transparent);border:1px solid color-mix(in srgb,#fff 28%,transparent);backdrop-filter:blur(4px);display:grid;place-items:center;text-align:center}
.plumex-home .reframe{background:var(--brand-soft)}
.plumex-home .reframe-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.plumex-home .reframe h2{font-size:clamp(1.9rem,3.6vw,2.8rem);margin:14px 0 20px;max-width:16ch}
.plumex-home .reframe p{color:var(--ink-soft);margin-bottom:16px}
.plumex-home .reframe .accent{font-family:var(--display);font-style:italic;font-size:1.45rem;color:var(--brand-ink);padding-left:18px;border-left:3px solid var(--brand-accent);line-height:1.35;margin-top:6px}
.plumex-home .reframe-art{aspect-ratio:1/1.05;border-radius:var(--r);position:relative;overflow:hidden;background:linear-gradient(160deg,var(--brand-bg),color-mix(in srgb,var(--brand-accent) 16%,var(--brand-bg)))}
.plumex-home .reframe-art .layer{position:absolute;left:24px;right:24px;padding:15px 18px;border-radius:12px;background:color-mix(in srgb,#fff 78%,transparent);backdrop-filter:blur(4px);font-size:.9rem;box-shadow:0 14px 28px -20px color-mix(in srgb,var(--brand-ink) 55%,transparent)}
.plumex-home .reframe-art .l1{top:24px}
.plumex-home .reframe-art .l1 b{color:var(--ink-soft)}
.plumex-home .reframe-art .l2{bottom:24px;background:var(--brand-dark);color:#fff}
.plumex-home .reframe-art .l2 b{color:var(--brand-accent-2)}
.plumex-home .data{background:var(--brand-dark);color:#fff;text-align:center}
.plumex-home .data .eyebrow{color:color-mix(in srgb,var(--brand-accent) 70%,#fff)}
.plumex-home .data h2{font-size:clamp(1.7rem,3vw,2.3rem);color:#fff;max-width:22ch;margin:14px auto 46px}
.plumex-home .data-cols{display:grid;grid-template-columns:1fr auto 1fr;gap:28px;align-items:center;max-width:820px;margin:0 auto}
.plumex-home .data-num{font-family:var(--mono);font-weight:700;font-size:clamp(3rem,9vw,5.6rem);line-height:1}
.plumex-home .data-plumex .data-num{color:color-mix(in srgb,var(--brand-accent) 70%,#fff)}
.plumex-home .data-other{opacity:.55}
.plumex-home .data-lab{font-weight:600;letter-spacing:.13em;text-transform:uppercase;font-size:.72rem;margin-top:10px}
.plumex-home .data-sub{font-size:.85rem;color:color-mix(in srgb,#fff 60%,transparent);margin-top:6px}
.plumex-home .data-vs{font-family:var(--display);font-style:italic;font-size:1.35rem;color:color-mix(in srgb,#fff 50%,transparent)}
.plumex-home .data-note{margin-top:40px;font-size:.94rem;color:color-mix(in srgb,#fff 72%,transparent);max-width:52ch;margin-inline:auto}
.plumex-home .ritual-head{text-align:center;max-width:560px;margin:0 auto 50px}
.plumex-home .ritual-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 8px}
.plumex-home .ritual-head p{color:var(--ink-soft)}
.plumex-home .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.plumex-home .step{background:var(--brand-soft);border:1px solid var(--line);border-radius:var(--r);padding:28px 22px}
.plumex-home .step .no{font-family:var(--mono);font-size:.85rem;color:var(--brand-accent);font-weight:700}
.plumex-home .step h3{font-size:1.22rem;margin:14px 0 7px}
.plumex-home .step p{font-size:.89rem;color:var(--ink-soft)}
.plumex-home .step .bar{height:3px;background:linear-gradient(90deg,var(--brand-accent-2),var(--brand-accent));border-radius:3px;margin-top:18px;width:32px}
.plumex-home .ben-head{max-width:640px;margin:0 auto 46px;text-align:center}
.plumex-home .ben-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 8px}
.plumex-home .ben-head p{color:var(--ink-soft)}
.plumex-home .ben-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.plumex-home .ben{padding:24px 20px;border-radius:14px;background:var(--brand-soft);border:1px solid var(--line)}
.plumex-home .ben .ic{font-size:1.35rem;margin-bottom:11px}
.plumex-home .ben h3{font-size:1.05rem;margin-bottom:5px}
.plumex-home .ben p{font-size:.85rem;color:var(--ink-soft)}
.plumex-home .cmp-head{text-align:center;margin:0 auto 42px;max-width:560px}
.plumex-home .cmp-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 8px}
.plumex-home .cmp-head p{color:var(--ink-soft)}
.plumex-home .cmp{max-width:840px;margin:0 auto;border-radius:var(--r);overflow:hidden;border:1px solid var(--line)}
.plumex-home .cmp-row{display:grid;grid-template-columns:1.3fr 1fr 1fr;align-items:center}
.plumex-home .cmp-row+.cmp-row{border-top:1px solid var(--line)}
.plumex-home .cmp-row>div{padding:15px 20px;font-size:.92rem}
.plumex-home .cmp-row .lbl{font-weight:600}
.plumex-home .cmp-row .plx{background:color-mix(in srgb,var(--brand-accent) 12%,transparent);font-weight:500}
.plumex-home .cmp-row .oth{color:var(--ink-soft)}
.plumex-home .cmp-head-row{background:var(--brand-dark);color:#fff}
.plumex-home .cmp-head-row>div{padding:17px 20px;font-weight:600;font-size:.9rem}
.plumex-home .cmp-head-row .plx{background:var(--brand-dark);color:color-mix(in srgb,var(--brand-accent) 70%,#fff)}
.plumex-home .cmp .tick{color:var(--brand-accent);font-weight:700;margin-right:5px}
.plumex-home .reviews{background:var(--brand-soft)}
.plumex-home .rev-head{text-align:center;margin-bottom:44px}
.plumex-home .rev-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 10px}
.plumex-home .rev-grid{columns:3;column-gap:18px}
.plumex-home .rev{background:var(--brand-bg);border:1px solid var(--line);border-radius:15px;padding:22px;margin-bottom:18px;break-inside:avoid}
.plumex-home .rev .stars{font-size:.95rem;margin-bottom:11px}
.plumex-home .rev h4{font-family:var(--display);font-size:1.14rem;margin-bottom:7px}
.plumex-home .rev p{font-size:.89rem;color:var(--ink-soft);margin-bottom:13px}
.plumex-home .rev .who{font-size:.82rem;font-weight:600}
.plumex-home .rev .who span{color:var(--brand-accent);font-weight:500}
.plumex-home .stats{background:var(--brand-dark);color:#fff}
.plumex-home .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;text-align:center}
.plumex-home .stat .n{font-family:var(--display);font-size:clamp(2.3rem,5vw,3.3rem);color:#fff}
.plumex-home .stat .n em{font-style:italic;color:color-mix(in srgb,var(--brand-accent) 70%,#fff)}
.plumex-home .stat .l{font-size:.82rem;color:color-mix(in srgb,#fff 65%,transparent);letter-spacing:.04em;margin-top:6px}
.plumex-home .offer-card{max-width:960px;margin:0 auto;border-radius:calc(var(--r) + 6px);overflow:hidden;display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);box-shadow:0 40px 86px -50px color-mix(in srgb,var(--brand-ink) 60%,transparent)}
.plumex-home .offer-visual{background:linear-gradient(160deg,color-mix(in srgb,var(--brand-accent) 18%,var(--brand-bg)),var(--brand-soft));display:grid;place-items:center;min-height:330px}
.plumex-home .offer-body{padding:clamp(32px,4vw,52px)}
.plumex-home .offer-body .eyebrow{margin-bottom:12px}
.plumex-home .offer-body h2{font-size:clamp(1.8rem,3.2vw,2.5rem);margin-bottom:14px}
.plumex-home .offer-body>p{color:var(--ink-soft)}
.plumex-home .offer-price{display:flex;align-items:baseline;gap:12px;margin:18px 0 6px}
.plumex-home .offer-price .now{font-family:var(--display);font-size:2.3rem}
.plumex-home .offer-price .duo-price{font-size:.9rem;color:var(--ink-soft)}
.plumex-home .offer-list{list-style:none;margin:16px 0 26px;display:flex;flex-direction:column;gap:9px}
.plumex-home .offer-list li{display:flex;gap:10px;font-size:.93rem}
.plumex-home .offer-list li::before{content:"❄";color:var(--brand-accent)}
.plumex-home .offer-badges{display:flex;gap:16px;margin-top:18px;flex-wrap:wrap;font-size:.8rem;color:var(--ink-soft)}
.plumex-home .faq{max-width:760px;margin:0 auto}
.plumex-home .faq-head{text-align:center;margin-bottom:40px}
.plumex-home .faq-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin-top:10px}
.plumex-home .q{border-bottom:1px solid var(--line)}
.plumex-home .q button{width:100%;background:none;border:none;text-align:left;cursor:pointer;padding:21px 4px;font-family:var(--display);font-size:1.18rem;color:var(--brand-ink);display:flex;justify-content:space-between;align-items:center;gap:20px}
.plumex-home .q .sign{font-family:var(--body);font-size:1.4rem;color:var(--brand-accent);transition:transform .3s var(--ease);flex:none}
.plumex-home .q.open .sign{transform:rotate(45deg)}
.plumex-home .q .a{max-height:0;overflow:hidden;transition:max-height .4s var(--ease)}
.plumex-home .q .a p{padding:0 4px 21px;color:var(--ink-soft);font-size:.94rem;max-width:60ch}
.plumex-home .cine{position:relative;background:var(--brand-dark);color:#fff;overflow:hidden}
.plumex-home .cine::before{content:"";position:absolute;inset:0;opacity:.55;background:radial-gradient(60% 60% at 18% 8%,color-mix(in srgb,var(--brand-accent) 48%,transparent),transparent 60%),radial-gradient(55% 55% at 92% 92%,color-mix(in srgb,var(--brand-accent-2) 42%,transparent),transparent 60%)}
.plumex-home .cine .wrap{position:relative;z-index:2}
.plumex-home .cine-head{text-align:center;max-width:720px;margin:0 auto 40px}
.plumex-home .cine .eyebrow{color:color-mix(in srgb,var(--brand-accent) 60%,#fff)}
.plumex-home .cine h2{color:#fff;font-size:clamp(2rem,4vw,3.2rem);margin:14px 0 12px}
.plumex-home .cine-head p{color:color-mix(in srgb,#fff 78%,transparent)}
.plumex-home .cine-stage{position:relative;border-radius:calc(var(--r) + 4px);overflow:hidden;aspect-ratio:16/9;box-shadow:0 50px 100px -40px rgba(0,0,0,.7);background:linear-gradient(135deg,color-mix(in srgb,var(--brand-accent) 40%,var(--brand-dark)),var(--brand-dark))}
.plumex-home .cine-stage video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.plumex-home .cine-poster{position:absolute;inset:0;display:grid;place-items:center;align-content:center;gap:14px;text-align:center}
.plumex-home .play{width:78px;height:78px;border-radius:50%;background:rgba(255,255,255,.92);display:grid;place-items:center;cursor:pointer;transition:transform .3s var(--ease);box-shadow:0 14px 34px -10px rgba(0,0,0,.55)}
.plumex-home .play:hover{transform:scale(1.08)}
.plumex-home .play::after{content:"";width:0;height:0;border-left:22px solid var(--brand-ink);border-top:14px solid transparent;border-bottom:14px solid transparent;margin-left:6px}
.plumex-home .cine-poster .cap{color:color-mix(in srgb,#fff 80%,transparent);font-size:.82rem;letter-spacing:.04em}
.plumex-home .cine-cta{text-align:center;margin-top:32px}
.plumex-home .reels-head{display:flex;justify-content:space-between;align-items:baseline;margin:60px auto 20px;gap:16px}
.plumex-home .reels-head h3{color:#fff;font-size:clamp(1.4rem,2.4vw,2rem)}
.plumex-home .reels-head span{color:color-mix(in srgb,#fff 58%,transparent);font-size:.85rem}
.plumex-home .reels{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;-webkit-overflow-scrolling:touch}
.plumex-home .reels::-webkit-scrollbar{height:6px}
.plumex-home .reels::-webkit-scrollbar-thumb{background:color-mix(in srgb,#fff 25%,transparent);border-radius:6px}
.plumex-home .reel{flex:none;width:212px;aspect-ratio:9/16;border-radius:16px;scroll-snap-align:start;position:relative;overflow:hidden;background:linear-gradient(160deg,color-mix(in srgb,var(--brand-accent) 32%,var(--brand-dark)),var(--brand-dark));border:1px solid color-mix(in srgb,#fff 14%,transparent)}
.plumex-home .reel .play{width:50px;height:50px;position:absolute;top:44%;left:50%;transform:translate(-50%,-50%)}
.plumex-home .reel .play::after{border-left-width:14px;border-top-width:9px;border-bottom-width:9px;margin-left:4px}
.plumex-home .reel .rcap{position:absolute;left:0;right:0;bottom:0;padding:16px 14px;background:linear-gradient(transparent,rgba(0,0,0,.6));font-size:.78rem;color:color-mix(in srgb,#fff 82%,transparent)}
.plumex-home .reel .rcap b{display:block;font-family:var(--display);font-weight:600;font-size:.98rem;color:#fff;margin-bottom:2px}
@media(max-width:560px){.plumex-home .reel{width:168px}}
.plumex-home .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.plumex-home .reveal.in{opacity:1;transform:none}
@media(max-width:960px){.plumex-home .hero-grid{grid-template-columns:1fr;gap:38px}
.plumex-home .hero-visual{max-width:440px;margin:0 auto;width:100%}
.plumex-home .sens-grid,.plumex-home .steps,.plumex-home .ben-grid,.plumex-home .stats-grid{grid-template-columns:repeat(2,1fr)}
.plumex-home .duo-body,.plumex-home .reframe-grid,.plumex-home .offer-card{grid-template-columns:1fr}
.plumex-home .duo-visual,.plumex-home .offer-visual{max-width:460px}
.plumex-home .rev-grid{columns:2}}
@media(max-width:560px){.plumex-home .sens-grid,.plumex-home .steps,.plumex-home .ben-grid,.plumex-home .stats-grid,.plumex-home .rev-grid{grid-template-columns:1fr;columns:1}
.plumex-home .cmp-row{grid-template-columns:1fr}
.plumex-home .cmp-row .oth,.plumex-home .cmp-head-row .oth{display:none}
.plumex-home .data-cols{grid-template-columns:1fr}
.plumex-home .data-vs{transform:rotate(90deg)}
.plumex-home .duo-head{flex-direction:column;align-items:flex-start}
.plumex-home .offer-price{flex-direction:column;gap:2px;align-items:flex-start}}
@media(prefers-reduced-motion:reduce){.plumex-home *{animation:none!important;transition:none!important}
.plumex-home .reveal{opacity:1;transform:none}}
/* --- images réelles produit : ajustements (remplace les img-slot placeholders) --- */
.plumex-home .glass-card{overflow:hidden}
.plumex-home .glass-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.plumex-home .duo-visual{position:relative;overflow:hidden}
.plumex-home .duo-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.plumex-home .duo-visual-tag{position:absolute;left:16px;bottom:16px;z-index:2;background:color-mix(in srgb,#fff 92%,transparent);color:var(--brand-ink);font-size:.78rem;font-weight:600;padding:8px 16px;border-radius:100px;backdrop-filter:blur(4px)}
.plumex-home .offer-visual{position:relative;overflow:hidden}
.plumex-home .offer-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

