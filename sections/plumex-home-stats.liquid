{% comment %}
  PlumeX — Home v3 — Bandeau de statistiques
{% endcomment %}
{% style %}
.plumex-home .stats{background:var(--brand-dark);color:#fff}
.plumex-home .stats-head{text-align:center;max-width:560px;margin:0 auto 40px}
.plumex-home .stats-head h2{color:#fff;font-size:clamp(1.7rem,3vw,2.3rem);margin:12px 0 0}
.plumex-home .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;text-align:center}
.plumex-home .stat .n{font-family:var(--display);font-size:clamp(2.3rem,5vw,3.3rem);color:#fff}
.plumex-home .stat .n em{font-style:italic;color:color-mix(in srgb,var(--brand-accent) 70%,#fff)}
.plumex-home .stat .l{font-size:.82rem;color:color-mix(in srgb,#fff 65%,transparent);letter-spacing:.04em;margin-top:6px}
@media(max-width:960px){ .plumex-home .stats-grid{grid-template-columns:repeat(2,1fr)} }
@media(max-width:560px){ .plumex-home .stats-grid{grid-template-columns:1fr} }
{% endstyle %}

<div class="plumex-home">
  <section class="stats section">
    <div class="wrap">
      {% if section.settings.heading != blank %}
        <div class="stats-head reveal">
          {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
      <div class="stats-grid">
        {% for block in section.blocks %}
          <div class="stat reveal" {{ block.shopify_attributes }}>
            <div class="n">{{ block.settings.number }}<em>{{ block.settings.suffix }}</em></div>
            <div class="l">{{ block.settings.label }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PlumeX — Statistiques",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optionnel)" },
    { "type": "text", "id": "heading", "label": "Titre (optionnel)" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistique",
      "settings": [
        { "type": "text", "id": "number", "label": "Nombre", "default": "47" },
        { "type": "text", "id": "suffix", "label": "Suffixe (petit texte en italique)", "default": "%" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "Clients fidèles" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PlumeX — Statistiques",
      "blocks": [
        { "type": "stat", "settings": { "number": "47", "suffix": "%", "label": "Clients fidèles" } },
        { "type": "stat", "settings": { "number": "+12", "suffix": "K", "label": "Commandes expédiées" } },
        { "type": "stat", "settings": { "number": "4,8", "suffix": "/5", "label": "Note moyenne" } },
        { "type": "stat", "settings": { "number": "30", "suffix": "j", "label": "Satisfait ou remboursé" } }
      ]
    }
  ]
}
{% endschema %}
