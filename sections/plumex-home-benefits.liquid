{% comment %}
  PlumeX — Home v3 — Bénéfices
{% endcomment %}
{% style %}
.plumex-home .ben-head{max-width:640px;margin:0 auto 46px;text-align:center}
.plumex-home .ben-head h2{font-size:clamp(1.9rem,3.5vw,2.8rem);margin:12px 0 8px}
.plumex-home .ben-head p{color:var(--ink-soft)}
.plumex-home .ben-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.plumex-home .ben{padding:24px 20px;border-radius:14px;background:var(--brand-soft);border:1px solid var(--line)}
.plumex-home .ben .ic{font-size:1.35rem;margin-bottom:11px}
.plumex-home .ben h3{font-size:1.05rem;margin-bottom:5px}
.plumex-home .ben p{font-size:.85rem;color:var(--ink-soft)}
@media(max-width:960px){ .plumex-home .ben-grid{grid-template-columns:repeat(2,1fr)} }
@media(max-width:560px){ .plumex-home .ben-grid{grid-template-columns:1fr} }
{% endstyle %}

<div class="plumex-home">
  <section class="benefits section" style="background:var(--brand-bg)">
    <div class="wrap">
      <div class="ben-head reveal">
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.lead }}</p>
      </div>
      <div class="ben-grid">
        {% for block in section.blocks %}
          <div class="ben reveal" {{ block.shopify_attributes }}>
            <div class="ic">{{ block.settings.icon }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PlumeX — Bénéfices",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ce que le froid fait, tout de suite" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un teint frais et reposé, dès les premières minutes." },
    { "type": "textarea", "id": "lead", "label": "Sous-titre", "default": "Des effets immédiats et visibles, sans promesse en l'air." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icône (emoji)", "default": "💧" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Dégonfle poches & cernes" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Un regard reposé, comme après une nuit complète." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PlumeX — Bénéfices",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "💧", "title": "Dégonfle poches & cernes", "description": "Un regard reposé, comme après une nuit complète." } },
        { "type": "benefit", "settings": { "icon": "✨", "title": "Effet bonne mine", "description": "Le teint est ravivé, plus lumineux, moins terne." } },
        { "type": "benefit", "settings": { "icon": "🧊", "title": "Pores resserrés", "description": "La fraîcheur affine le grain sur l'instant." } },
        { "type": "benefit", "settings": { "icon": "🪶", "title": "Traits défatigués", "description": "10 à 15 minutes pour un visage plus frais." } }
      ]
    }
  ]
}
{% endschema %}
