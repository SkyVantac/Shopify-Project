{% comment %}
  PlumeX — Home v3 — Rituel Matin / Soir (toggle)
{% endcomment %}
{% assign featured_product = all_products['masque-cryo-plumex™-decongestionne-anti-migraine-copie'] %}
{% assign visual_image = section.settings.visual_image | default: featured_product.images[4] %}
{% style %}
.plumex-home .duo{position:relative;color:#fff;transition:background .8s var(--ease)}
.plumex-home .duo[data-mode="matin"]{background:linear-gradient(120deg,color-mix(in srgb,var(--brand-accent-2) 88%,#fff),var(--brand-accent-2) 55%,color-mix(in srgb,var(--brand-accent-2) 40%,var(--brand-dark)))}
.plumex-home .duo[data-mode="soir"]{background:linear-gradient(120deg,color-mix(in srgb,var(--brand-accent) 70%,var(--brand-dark)),var(--brand-dark) 60%,#0C0A22)}
.plumex-home .duo .wrap{position:relative;z-index:2}
.plumex-home .duo-head{display:flex;justify-content:space-between;align-items:flex-end;gap:22px;flex-wrap:wrap;margin-bottom:40px}
.plumex-home .duo-head .eyebrow{color:color-mix(in srgb,#fff 74%,transparent)}
.plumex-home .duo-head h2{font-size:clamp(1.9rem,3.6vw,3rem);color:#fff;max-width:16ch}
.plumex-home .toggle{display:inline-flex;background:color-mix(in srgb,#fff 16%,transparent);border:1px solid color-mix(in srgb,#fff 30%,transparent);border-radius:100px;padding:5px;backdrop-filter:blur(6px)}
.plumex-home .toggle button{font-family:var(--body);font-weight:600;font-size:.94rem;color:#fff;background:transparent;border:none;padding:10px 24px;border-radius:100px;cursor:pointer;transition:.35s var(--ease);opacity:.8;min-height:44px}
.plumex-home .toggle button.on{background:#fff;color:var(--brand-ink);opacity:1}
.plumex-home .duo-body{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;min-height:270px}
.plumex-home .duo-panel{display:none;animation:plumexHome_fade .55s var(--ease)}
.plumex-home .duo-panel.show{display:block}
@keyframes plumexHome_fade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.plumex-home .duo-panel .tag{font-family:var(--mono);font-size:.8rem;letter-spacing:.04em;color:color-mix(in srgb,#fff 82%,transparent);margin-bottom:14px}
.plumex-home .duo-panel h3{font-size:clamp(1.6rem,3vw,2.3rem);color:#fff;margin-bottom:14px}
.plumex-home .duo-panel p{color:color-mix(in srgb,#fff 88%,transparent);max-width:42ch;margin-bottom:20px}
.plumex-home .duo-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.plumex-home .duo-list li{display:flex;gap:11px;align-items:center;font-size:.97rem;color:color-mix(in srgb,#fff 92%,transparent)}
.plumex-home .duo-list li::before{content:"";width:7px;height:7px;border-radius:50%;background:#fff;flex:none}
.plumex-home .duo-visual{aspect-ratio:1/1;border-radius:var(--r);background:color-mix(in srgb,#fff 12%,transparent);border:1px solid color-mix(in srgb,#fff 28%,transparent);backdrop-filter:blur(4px);display:grid;place-items:center;text-align:center;position:relative;overflow:hidden}
.plumex-home .duo-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.plumex-home .duo-visual-tag{position:absolute;left:16px;bottom:16px;z-index:2;background:color-mix(in srgb,#fff 92%,transparent);color:var(--brand-ink);font-size:.78rem;font-weight:600;padding:8px 16px;border-radius:100px;backdrop-filter:blur(4px)}
@media(max-width:960px){
  .plumex-home .duo-body{grid-template-columns:1fr}
  .plumex-home .duo-visual{max-width:460px;margin:0 auto}
}
@media(max-width:560px){
  .plumex-home .duo-head{flex-direction:column;align-items:flex-start}
}
{% endstyle %}

<div class="plumex-home">
  <section class="duo section" id="rituel" data-mode="matin">
    <div class="wrap">
      <div class="duo-head">
        <div>
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <div class="toggle" role="tablist" aria-label="Moment de la journée">
          <button class="on" data-set="matin" role="tab" aria-selected="true">☀️ Matin</button>
          <button data-set="soir" role="tab" aria-selected="false">🌙 Soir</button>
        </div>
      </div>
      <div class="duo-body">
        <div class="duo-panel show" data-panel="matin">
          <div class="tag">{{ section.settings.matin_tag }}</div>
          <h3>{{ section.settings.matin_title }}</h3>
          <p>{{ section.settings.matin_text }}</p>
          <ul class="duo-list">
            {% if section.settings.matin_item1 != blank %}<li>{{ section.settings.matin_item1 }}</li>{% endif %}
            {% if section.settings.matin_item2 != blank %}<li>{{ section.settings.matin_item2 }}</li>{% endif %}
            {% if section.settings.matin_item3 != blank %}<li>{{ section.settings.matin_item3 }}</li>{% endif %}
          </ul>
        </div>
        <div class="duo-panel" data-panel="soir">
          <div class="tag">{{ section.settings.soir_tag }}</div>
          <h3>{{ section.settings.soir_title }}</h3>
          <p>{{ section.settings.soir_text }}</p>
          <ul class="duo-list">
            {% if section.settings.soir_item1 != blank %}<li>{{ section.settings.soir_item1 }}</li>{% endif %}
            {% if section.settings.soir_item2 != blank %}<li>{{ section.settings.soir_item2 }}</li>{% endif %}
            {% if section.settings.soir_item3 != blank %}<li>{{ section.settings.soir_item3 }}</li>{% endif %}
          </ul>
        </div>
        <div class="duo-visual">
          {% if visual_image %}
            <img src="{{ visual_image | image_url: width: 900 }}" alt="{{ visual_image.alt | default: featured_product.title | escape }}" width="900" height="900" loading="lazy">
          {% endif %}
          <span class="duo-visual-tag" data-visual>Matin</span>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PlumeX — Matin/Soir",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Un geste pour ouvrir la journée · un geste pour la refermer" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le même masque. Deux rendez-vous par jour." },
    { "type": "header", "content": "Matin" },
    { "type": "text", "id": "matin_tag", "label": "Étiquette", "default": "06:45 — avant le maquillage" },
    { "type": "text", "id": "matin_title", "label": "Titre", "default": "Dégonfle & réveille." },
    { "type": "textarea", "id": "matin_text", "label": "Texte", "default": "Au réveil, le froid décongestionne poches et cernes et ravive le teint. Le geste qui remet le visage d'aplomb avant de commencer la journée." },
    { "type": "text", "id": "matin_item1", "label": "Point 1", "default": "Décongestionne poches et cernes" },
    { "type": "text", "id": "matin_item2", "label": "Point 2", "default": "Ravive un teint terne" },
    { "type": "text", "id": "matin_item3", "label": "Point 3", "default": "Resserre les pores sur l'instant" },
    { "type": "header", "content": "Soir" },
    { "type": "text", "id": "soir_tag", "label": "Étiquette", "default": "22:30 — après les écrans" },
    { "type": "text", "id": "soir_title", "label": "Titre", "default": "Défatigue & détend." },
    { "type": "textarea", "id": "soir_text", "label": "Texte", "default": "Le soir, le froid apaise la peau échauffée et relâche les muscles crispés par la journée. La finition qui clôt votre routine et prépare la nuit." },
    { "type": "text", "id": "soir_item1", "label": "Point 1", "default": "Relâche les tensions du visage" },
    { "type": "text", "id": "soir_item2", "label": "Point 2", "default": "Apaise la peau échauffée" },
    { "type": "text", "id": "soir_item3", "label": "Point 3", "default": "Prépare à une meilleure nuit" },
    { "type": "header", "content": "Visuel" },
    { "type": "image_picker", "id": "visual_image", "label": "Image (par défaut : image produit)" }
  ],
  "presets": [
    { "name": "PlumeX — Matin/Soir" }
  ]
}
{% endschema %}
