ype":"review","settings":{"namy_title":"Excellent service","namy_text":"<p>Livraison rapide, packaging soigné. Le produit tient ses promesses.</p>","namy_author":"Camille R.","namy_rating":5,"namy_date":"il y a 1 semaine","namy_verified":true,"namy_demo_avatar":"namy-demo-review-1.jpg"}},"review-4":{"type":"review","settings":{"namy_title":"J’adore","namy_text":"<p>Sceptique au début, mais l’effet sans maquillage est bluffant.</p>","namy_author":"Julie M.","namy_rating":5,"namy_date":"il y a 2 semaines","namy_verified":true,"namy_demo_avatar":"namy-demo-review-1.jpg"}},"review-5":{"type":"review","settings":{"namy_title":"Validé","namy_text":"<p>Je ne sors plus sans. Mon teint paraît parfait sans effort.</p>","namy_author":"Léa B.","namy_rating":5,"namy_date":"il y a 3 semaines","namy_verified":true,"namy_demo_avatar":"namy-demo-review-1.jpg"}}},"block_order":["review-1","review-2","review-3","review-4","review-5"],"settings":{"namy_show_on_display":"desktop_and_mobile","namy_full_width":true,"namy_color_scheme":"","namy_heading":"Nos clients en parlent mieux que nous","namy_score":0,"namy_count":"","namy_show_trustpilot_logo":true,"namy_emit_jsonld":true,"namy_speed":80,"namy_pause_on_hover":true,"namy_image_style":"avatar","namy_cta_label":"Tout voir sur Trustpilot","namy_cta_url":"","namy_cta_style":"primary","namy_padding_top":60,"namy_padding_bottom":60,"namy_margin_top":0,"namy_margin_bottom":0,"namy_rounded_top":false,"namy_rounded_bottom":false,"namy_stack_backdrop_scheme":"","namy_additional_class":""}},"authority-grid-test":{"type":"xswmkn-authority-grid","blocks":{"card-1":{"type":"_xswmkn-authority-card","settings":{"namy_demo_image":"namy-demo-influ-1.png","namy_name":"Camille Vidal","namy_role":"Fondatrice de Namyskin","namy_credential":"UNE MARQUE NÉE D'UN BESOIN PERSONNEL","namy_quote":"<p>Je cherchais un soin assez doux pour ma peau réactive. Il n'existait pas. Alors je l'ai créé — avec les personnes en qui j'avais le plus confiance.</p>","namy_reveal_index":1},"blocks":{}},"card-2":{"type":"_xswmkn-authority-card","settings":{"namy_demo_image":"namy-demo-influ-2.png","namy_name":"Dr. Sarah Mendel","namy_role":"Dermatologue · Conseil scientifique","namy_credential":"20 ANS AUPRÈS DES PEAUX SENSIBLES","namy_quote":"<p>Chaque ingrédient est choisi pour respecter la barrière cutanée. Rien n'entre dans la formule sans preuve scientifique.</p>","namy_reveal_index":2},"blocks":{}},"card-3":{"type":"_xswmkn-authority-card","settings":{"namy_demo_image":"namy-demo-influ-3.png","namy_name":"Lena Hoffmann","namy_role":"Responsable formulation · R&D","namy_credential":"NOTRE ÉQUIPE, OBSÉDÉE PAR LE DÉTAIL","namy_quote":"<p>On teste, on recommence, on affine — jusqu'à ce que la texture soit parfaite. C'est tout l'esprit de l'équipe Namyskin.</p>","namy_reveal_index":3},"blocks":{}}},"block_order":["card-1","card-2","card-3"],"settings":{"namy_show_on_display":"desktop_and_mobile","namy_full_width":true,"namy_color_scheme":"scheme-3","namy_kicker":"NOTRE HISTOIRE","namy_heading":"<p>Une marque née d'un <em>besoin personnel.</em></p>","namy_intro":"<p>Namyskin est née le jour où nous n'avons trouvé aucun soin assez doux pour les peaux réactives. Alors nous l'avons créé — entourés de dermatologues et d'une équipe obsédée par chaque détail.</p>","namy_bg_image_fit":"cover","namy_text_protection":"scrim","namy_bg_overlay_color":"#000000","namy_bg_overlay_opacity":40,"namy_card_aspect":"1/1","namy_show_decorative_glow":true,"namy_show_noise_texture":false,"namy_show_stat_bar":true,"namy_stat_rating":"4.9","namy_stat_rating_label":"sur 5","namy_stat_rating_count":"12,500","namy_stat_count_label":"avis vérifiés","namy_padding_top":96,"namy_padding_bottom":96,"namy_rounded_top":false,"namy_rounded_bottom":true,"namy_stack_backdrop_scheme":"scheme-2","namy_margin_top":0,"namy_margin_bottom":0,"namy_additional_class":""}},"pdp-comparison":{"type":"xswmkn-feature-matrix","blocks":{"row-1":{"type":"matrix_row","settings":{"namy_label":